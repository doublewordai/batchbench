FROM pytorch/pytorch:2.9.0-cuda12.6-cudnn9-devel

# git installation and build dependencies
# python3-dev needed for pplx rust bindings build \
# libfabric-dev, libibverbs-dev, libpmix-dev, libopenmpi-dev, openmpi-common, openmpi-bin for nvshmem build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
     git curl wget build-essential ninja-build cmake pkg-config \
     librdmacm-dev rdma-core libfabric-dev libibverbs-dev \
     python3-dev \
 && rm -rf /var/lib/apt/lists/*

# GDRCopy
RUN apt-get update && apt-get install -y build-essential devscripts debhelper fakeroot pkg-config wget
RUN cd /tmp && \
    wget https://github.com/NVIDIA/gdrcopy/archive/refs/tags/v2.5.1.tar.gz && \
    tar -xf v2.5.1.tar.gz && \
    cd gdrcopy-2.5.1/packages/ && \
    CUDA=/usr/local/cuda ./build-deb-packages.sh -t -k

RUN dpkg -i /tmp/gdrcopy-2.5.1/packages/libgdrapi_2.5.1-1_amd64.*.deb

# NVSHMEM 3.2.5 build and install for DeepEP all2all kernels
# Don't install MPI and use built-in launcher Hydra
# Command adapted from:
# https://github.com/perplexityai/pplx-kernels/blob/master/docs/install-driver-and-dependencies.md
RUN set -eux; \
    cd /tmp; \
    wget https://developer.nvidia.com/downloads/assets/secure/nvshmem/nvshmem_src_3.2.5-1.txz; \
    mkdir -p nvshmem_src_3.2.5-1; \
    tar xf nvshmem_src_3.2.5-1.txz -C nvshmem_src_3.2.5-1; \
    cd nvshmem_src_3.2.5-1/nvshmem_src; \
    mkdir -p build; \
    cd build; \
    cmake \
        -DNVSHMEM_PREFIX=/opt/nvshmem-3.2.5 \
        -DCMAKE_CUDA_ARCHITECTURES=90a \
        -DNVSHMEM_MPI_SUPPORT=0 \
        -DNVSHMEM_PMIX_SUPPORT=0 \
        -DNVSHMEM_USE_GDRCOPY=1 \
        -DNVSHMEM_IBGDA_SUPPORT=1 \
        -DNVSHMEM_BUILD_TESTS=1 \
        -DNVSHMEM_BUILD_EXAMPLES=1 \
        -DNVSHMEM_BUILD_HYDRA_LAUNCHER=1 \
        -DNVSHMEM_BUILD_TXZ_PACKAGE=1 \
        -G Ninja \
        ..; \
        ninja; \
        ninja install; \
        rm -rf /tmp/nvshmem_src_3.2.5-1.txz

ENV NVSHMEM_HOME=/opt/nvshmem-3.2.5
ENV LD_LIBRARY_PATH=${NVSHMEM_HOME}/lib:${LD_LIBRARY_PATH}
ENV PATH=/opt/hydra/bin:${PATH}


# deepep installation
RUN set -eux; \
    git clone https://github.com/deepseek-ai/DeepEP /deepep; \
    cd /deepep; \
    NVSHMEM_DIR=/opt/nvshmem-3.2.5 python setup.py install
    

# uv installation
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && ln -s /root/.local/bin/uv /usr/local/bin/uv

# install vllm in a uv virtual environment (takes a long time)
# we run it separately so that it can be cached by docker layers, and doesn't need reinstalling 
# when we update batchbench code
RUN cd /workspace/batchbench; \
    uv venv /opt/batchbench/.venv; \
    . /opt/batchbench/.venv/bin/activate; \
    uv pip install vllm --torch-backend=auto; \
    deactivate

# Copy local source files for faster development cycle
COPY /pyproject.toml /README.md /MANIFEST.in /workspace/batchbench/
COPY /src/ /workspace/batchbench/src/

# Install BatchBench from local source
RUN set -eux; \
    cd /workspace/batchbench; \
    . /opt/batchbench/.venv/bin/activate; \
    uv pip install --no-cache-dir ".[offline,generate]"; \
    deactivate

# add uv venv to path for runtime
ENV PATH="/opt/batchbench/.venv/bin:$PATH"

# Install SSH server and dependencies
RUN apt-get update && \
apt-get install -y openssh-server && \
apt-get clean && \
rm -rf /var/lib/apt/lists/*

# Configure SSH
RUN mkdir -p /var/run/sshd && \
sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config && \
sed -i 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' /etc/pam.d/sshd && \
ssh-keygen -A

# Create SSH directory for root
RUN mkdir -p /root/.ssh && \
chmod 700 /root/.ssh

# Install BatchBench entrypoint wrapper
COPY ./docker/run_docker.py /usr/local/bin/batchbench-entrypoint
RUN chmod +x /usr/local/bin/batchbench-entrypoint

# Copy example config files
COPY ./docker/config.*.yaml /etc/batchbench/examples/

ENTRYPOINT ["/usr/local/bin/batchbench-entrypoint"]
CMD []
